PORT=3001
# The server loads .env.local (Neon CLI), then .env; injected variables win.
# Local development persists JSON only when DATABASE_URL is empty/unset.
DATA_FILE=./data/db.json
DATABASE_URL=
# Direct URL for schema/admin tooling; normal application traffic uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Branch identifier provisioned by Neon CLI; informational, not an auth credential.
NEON_BRANCH=
# Required on Vercel: generate random values (32+ and 16+ characters).
SESSION_SECRET=
ANALYST_PASSWORD=
ALLOW_DEMO_SIGNUP=true
# Optional offline demo without a key; configure for the challenge LLM flow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_DAILY_LIMIT=100
# Opt-in simulated legacy outage in milliseconds after each process starts.
LEGACY_OUTAGE_MS=0
