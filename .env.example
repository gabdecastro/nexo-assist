PORT=3001
# Local development persists JSON; Neon is used when DATABASE_URL is set.
DATA_FILE=./data/db.json
DATABASE_URL=
# Required on Vercel: generate random values (32+ and 16+ characters).
SESSION_SECRET=
ANALYST_PASSWORD=
ALLOW_DEMO_SIGNUP=true
# Optional offline demo without a key; configure for the challenge LLM flow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_DAILY_LIMIT=100
# Opt-in simulated legacy outage in milliseconds after each process starts.
LEGACY_OUTAGE_MS=0
